def lib = library(
  identifier: 'cicd-n8n-library@master',
  retriever: modernSCM([
    $class: 'GitSCMSource',
    remote: 'http://atlassian.satnusa.com:7990/scm/jsl/cicd-n8n-library.git',
    credentialsId: 'bitbucket-satnusa-account'
  ])
)

pipeline {
  agent any

  parameters {
    choice(
      name: 'PIPELINE_MODE',
      choices: ['DEV_TO_REPO', 'REPO_TO_PROD', 'DEV_TO_PROD'],
      description: 'Pilih mode pipeline: DEV_TO_REPO | REPO_TO_PROD | DEV_TO_PROD'
    )
  }

  environment {
    WORKFLOW_ID = 'vZKma9MU6KhxsPNI'

    PROD_DEPLOY_TARGET = 'docker'
    DEV_DEPLOY_TARGET = 'docker'

    ENABLE_ERROR_HANDLER = 'true'
    PROD_ERROR_WORKFLOW_ID = '8BkbvyZ93Pb68cT'
    ENABLE_DEFAULT_TIMEOUT = 'true'
    
    SSH_CRED_ID  = 'n8n-cross-server-ssh'
    DEV_SSH_HOST = '192.168.88.20'
    DEV_SSH_USER = 'jenkins'
    DEV_SSH_PORT = '22'

    PROD_SSH_HOST = '192.168.88.80'
    PROD_SSH_USER = 'jenkins'
    PROD_SSH_PORT = '22'
    PROD_N8N_API_BASE_URL = 'https://n8nprod.satnusa.com/api/v1'
    DEV_N8N_API_BASE_URL = 'https://n8ndev.satnusa.com/api/v1'
    PROD_N8N_API_KEY_CRED_ID = 'n8n-production-api-key'
    DEV_N8N_API_KEY_CRED_ID = 'n8n-development-api-key'

    DEV_PG_HOST = '192.168.88.20'
    DEV_PG_PORT = '65432'
    DEV_PG_DATABASE = 'n8n'
    DEV_PG_USER = 'n8n'
    DEV_PG_PASSWORD_CRED_ID = 'n8n-postgres-password'
    DEV_CONTAINER    = 'n8n-dev'
    
    PROD_KUBECONFIG = '/var/jenkins_home/n8n/kubeconfig-88.88'
    PROD_K8S_NAMESPACE = 'n8n-testing'
    PROD_K8S_POD_SELECTOR = 'app=n8n-main'
    PROD_PG_HOST = '192.168.88.80'
    PROD_PG_PORT = '65432'
    PROD_PG_DATABASE = 'n8n'
    PROD_PG_USER = 'n8n'
    PROD_PG_PASSWORD_CRED_ID = 'n8n-postgres-password'
    PROD_CONTAINER    = 'n8n-prod'

    REPO_HTTP = 'http://atlassian.satnusa.com:7990/scm/dvo/n8n-cicd-workflows.git'
    GIT_CRED_ID = 'bitbucket-satnusa-account'

    APPROVER = 'o.midiyanto, fathur.wiriansyah, fathur.morax'
    APPROVER_EMAIL = 'o.midiyanto@satnusa.com, fathur.wiriansyah@satnusa.com, arthurwiriansyah13@gmail.com'
    
    iTopTicketEnabled = 'true'
    iTopURL = 'https://servicedesk.satnusa.com'
    iTopCredentialId = 'itop-servicedesk-n8nautomation'
    iTopService = 'DEVSECOPS INCIDENTS'
    iTopServiceSubcategory = 'CI/CD Pipeline Failed'
    iTopUrgency = 'HIGH'
    iTopCallerUsername = 'n8nautomation'
    iTopAgentUsernames = 'o.midiyanto,fathur.wiriansyah'
  }

  stages {
    stage('Setup Build User Info') {
      steps {
        script {
          wrap([$class: 'BuildUser']) {
            env.authorName = env.BUILD_USER ?: 'Unknown'
            env.authorEmail = env.BUILD_USER_EMAIL ?: 'no-reply@example.com'
          }
        }
      }
    }

    stage('Checkout required files only') {
      steps {
        script {
          GitWorkflowOps.checkoutRequiredFiles(env.REPO_HTTP, env.GIT_CRED_ID)
        }
      }
    }

    stage('Prepare workflow branch') {
      when {
        expression { params.PIPELINE_MODE in ['DEV_TO_REPO', 'DEV_TO_PROD'] }
      }
      steps {
        script {
          GitWorkflowOps.prepareWorkflowBranch(env.GIT_CRED_ID, env.WORKFLOW_ID)
        }
      }
    }

    stage('Dev -> Repo (export)') {
      when {
        expression { params.PIPELINE_MODE in ['DEV_TO_REPO', 'DEV_TO_PROD'] }
      }
      steps {
        script {
          try {
            DeploymentOps.exportWorkflowFromDev(env.SSH_CRED_ID, env.WORKFLOW_ID)
          } catch (e) {
            if (e?.message?.contains('script returned exit code 42')) {
              currentBuild.result = 'ABORTED'
              error('[Pipeline] Workflow configuration/input error detected during DEV export.')
            }
            throw e
          }
        }
      }
    }

    stage('Validate sub-workflow') {
      when {
        expression { params.PIPELINE_MODE in ['DEV_TO_REPO', 'DEV_TO_PROD'] }
      }
      steps {
        script {
          try {
            env.SELECTED_SUBWORKFLOW_IDS = DeploymentOps.discoverAndSelectSubWorkflows(env.SSH_CRED_ID, env.WORKFLOW_ID) ?: ''

            if (env.SELECTED_SUBWORKFLOW_IDS?.trim()) {
              DeploymentOps.exportWorkflowFromDev(
                env.SSH_CRED_ID,
                env.WORKFLOW_ID,
                env.SELECTED_SUBWORKFLOW_IDS
              )
            }
          } catch (e) {
            if (e?.message?.contains('script returned exit code 42')) {
              currentBuild.result = 'ABORTED'
              error('[Pipeline] Workflow/sub-workflow configuration error detected during validation.')
            }
            throw e
          }
        }
      }
    }

    stage('Commit & push workflow file only') {
      when {
        expression { params.PIPELINE_MODE in ['DEV_TO_REPO', 'DEV_TO_PROD'] }
      }
      steps {
        script {
          GitWorkflowOps.commitAndPushWorkflowOnly(
            env.GIT_CRED_ID,
            env.WORKFLOW_ID,
            env.SELECTED_SUBWORKFLOW_IDS ?: '',
            env.authorName,
            env.authorEmail
          )
        }
      }
    }

    stage('Validate non-production credentials') {
      when {
        expression {
          params.PIPELINE_MODE in ['REPO_TO_PROD', 'DEV_TO_PROD']
        }
      }
      steps {
        script {
          try {
            if (!env.SELECTED_SUBWORKFLOW_IDS?.trim()) {
              env.SELECTED_SUBWORKFLOW_IDS = DeploymentOps.discoverSubWorkflowIdsFromRemoteWorkflowBranch(
                env.GIT_CRED_ID,
                env.WORKFLOW_ID
              ) ?: ''

              echo "Auto-discovered sub-workflow IDs for validation/deploy: ${env.SELECTED_SUBWORKFLOW_IDS ?: '(none)'}"
            }

            DeploymentOps.validateWorkflowCredentialsOnly(
              env.GIT_CRED_ID,
              env.WORKFLOW_ID,
              env.SELECTED_SUBWORKFLOW_IDS ?: ''
            )
          } catch (e) {
            if (e?.message?.contains('script returned exit code 42')) {
              currentBuild.result = 'ABORTED'
              error('[Pipeline] Workflow/credential configuration validation failed.')
            }
            if (e?.message?.contains('Branch workflow/') && e?.message?.contains('not found on remote')) {
              currentBuild.result = 'ABORTED'
              error("[Pipeline][HUMAN_ERROR] Workflow branch not found: workflow/${env.WORKFLOW_ID}. Check the workflowId or push the workflow first.")
            }
            throw e
          }
        }
      }
    }

    stage('Approval') {
      when {
        expression {
          params.PIPELINE_MODE in ['REPO_TO_PROD', 'DEV_TO_PROD']
        }
      }
      steps {
        script {
          def approvalInfo = PipelineGuard.requestTwoApprovals(
            params.PIPELINE_MODE,
            env.WORKFLOW_ID,
            env.APPROVER,
            env.APPROVER_EMAIL
          )

          env.FIRST_APPROVER  = approvalInfo.firstApprover ?: ''
          env.SECOND_APPROVER = approvalInfo.secondApprover ?: ''

          echo "Approval completed. Level 1: ${env.FIRST_APPROVER}, Level 2: ${env.SECOND_APPROVER}"
        }
      }
    }

    stage('Promote workflow file to master only') {
      when {
        expression { params.PIPELINE_MODE in ['REPO_TO_PROD', 'DEV_TO_PROD'] }
      }
      steps {
        script {
          GitWorkflowOps.promoteWorkflowToMaster(
            env.GIT_CRED_ID,
            env.WORKFLOW_ID,
            env.SELECTED_SUBWORKFLOW_IDS ?: '',
            env.authorName,
            env.authorEmail
          )
        }
      }
    }

    stage('Repo -> Prod (promote creds + deploy)') {
      when {
        expression { params.PIPELINE_MODE in ['REPO_TO_PROD', 'DEV_TO_PROD'] }
      }
      steps {
        script {
          DeploymentOps.deployFromRepoToProd(
            env.SSH_CRED_ID,
            env.WORKFLOW_ID,
            env.SELECTED_SUBWORKFLOW_IDS ?: ''
          )
        }
      }
    }
  }

  post {
    success {
      script {
        sendEmailTemplate(
          MAILMODE: 'POST_BUILD_REPORT',
          EXTRA_DATA: [
            buildResult: 'SUCCESS',
            firstApprover: env.FIRST_APPROVER,
            secondApprover: env.SECOND_APPROVER
          ]
        )
      }
    }

    failure {
      script {
        sendEmailTemplate(
          MAILMODE: 'POST_BUILD_REPORT',
          EXTRA_DATA: [
            buildResult: 'FAILURE',
            firstApprover: env.FIRST_APPROVER,
            secondApprover: env.SECOND_APPROVER
          ]
        )
        createiTopTicket()
      }
    }

    aborted {
      script {
        sendEmailTemplate(
          MAILMODE: 'POST_BUILD_REPORT',
          EXTRA_DATA: [
            buildResult: 'ABORTED',
            firstApprover: env.FIRST_APPROVER,
            secondApprover: env.SECOND_APPROVER
          ]
        )
      }
    }

    always {
      script {
        cleanWs()
      }
    }
  }
}