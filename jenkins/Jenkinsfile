def lib = library(
  identifier: 'cicd-n8n-library@master',
  retriever: modernSCM([
    $class: 'GitSCMSource',
    remote: 'http://atlassian.satnusa.com:7990/scm/jsl/cicd-n8n-library.git',
    credentialsId: 'bitbucket-satnusa-account'
  ])
)

pipeline {
  agent any

  parameters {
    choice(
      name: 'PIPELINE_MODE',
      choices: ['DEV_TO_REPO', 'REPO_TO_PROD', 'DEV_TO_PROD'],
      description: 'Pilih mode pipeline: DEV_TO_REPO | REPO_TO_PROD | DEV_TO_PROD'
    )
    choice(
      name: 'DEV_DEPLOY_TARGET',
      choices: ['docker', 'kubernetes'],
      description: 'Runtime n8n DEV untuk export workflow: docker atau kubernetes/kubectl'
    )
    choice(
      name: 'PROD_DEPLOY_TARGET',
      choices: ['docker', 'kubernetes'],
      description: 'Runtime n8n PROD untuk import/publish workflow: docker atau kubernetes/kubectl'
    )
  }

  environment {
    WORKFLOW_ID = 'vZKma9MU6KhxsPNI'

    SSH_CRED_ID  = 'n8n-cross-server-ssh'
    DEV_SSH_HOST = '192.168.88.20'
    DEV_SSH_USER = 'jenkins'
    DEV_SSH_PORT = '22'

    PROD_SSH_HOST = '192.168.88.80'
    PROD_SSH_USER = 'jenkins'
    PROD_SSH_PORT = '22'
    PROD_N8N_API_BASE_URL = 'https://n8nprod.satnusa.com/api/v1'
    PROD_N8N_API_KEY_CRED_ID = 'n8n-production-api-key'

    DEV_CONTAINER = 'n8n-dev'
    DEV_K8S_NAMESPACE = 'n8n-dev'
    DEV_K8S_POD_SELECTOR = 'app=n8n'
    DEV_K8S_CONTAINER = 'n8n'

    DEV_PG_HOST = '192.168.88.20'
    DEV_PG_PORT = '5432'
    DEV_PG_DATABASE = 'n8n'
    DEV_PG_USER = 'n8n'
    DEV_PG_PASSWORD_CRED_ID = 'n8n-dev-postgres-password'

    PROD_CONTAINER = 'n8n-prod'
    PROD_K8S_NAMESPACE = 'n8n-prod'
    PROD_K8S_POD_SELECTOR = 'app=n8n'
    PROD_K8S_CONTAINER = 'n8n'

    PROD_PG_HOST = '192.168.88.80'
    PROD_PG_PORT = '5432'
    PROD_PG_DATABASE = 'n8n'
    PROD_PG_USER = 'n8n'
    PROD_PG_PASSWORD_CRED_ID = 'n8n-prod-postgres-password'

    REPO_HTTP = 'http://atlassian.satnusa.com:7990/scm/dvo/n8n-cicd-workflows.git'
    GIT_CRED_ID = 'bitbucket-satnusa-account'

    APPROVER = 'o.midiyanto, fathur.wiriansyah, fathur.morax'
    APPROVER_EMAIL = 'o.midiyanto@satnusa.com, arthurwiriansyah@gmail.com, arthurwiriansyah13@gmail.com'
  }

  stages {
    stage('Setup Build User Info') {
      steps {
        script {
          wrap([$class: 'BuildUser']) {
            env.authorName = env.BUILD_USER ?: 'Unknown'
            env.authorEmail = env.BUILD_USER_EMAIL ?: 'no-reply@example.com'
          }
        }
      }
    }

    stage('Checkout required files only') {
      steps {
        script {
          GitWorkflowOps.checkoutRequiredFiles(env.REPO_HTTP, env.GIT_CRED_ID)
        }
      }
    }

    stage('Prepare workflow branch') {
      when {
        expression { params.PIPELINE_MODE in ['DEV_TO_REPO', 'DEV_TO_PROD'] }
      }
      steps {
        script {
          GitWorkflowOps.prepareWorkflowBranch(env.GIT_CRED_ID, env.WORKFLOW_ID)
        }
      }
    }

    stage('Dev -> Repo (export)') {
      when {
        expression { params.PIPELINE_MODE in ['DEV_TO_REPO', 'DEV_TO_PROD'] }
      }
      steps {
        script {
          DeploymentOps.exportWorkflowFromDev(env.SSH_CRED_ID, env.WORKFLOW_ID, '', params.DEV_DEPLOY_TARGET)
        }
      }
    }

    stage('Validate sub-workflow') {
      when {
        expression { params.PIPELINE_MODE in ['DEV_TO_REPO', 'DEV_TO_PROD'] }
      }
      steps {
        script {
          env.SELECTED_SUBWORKFLOW_IDS = DeploymentOps.discoverAndSelectSubWorkflows(env.SSH_CRED_ID, env.WORKFLOW_ID, params.DEV_DEPLOY_TARGET) ?: ''

          if (env.SELECTED_SUBWORKFLOW_IDS?.trim()) {
            DeploymentOps.exportWorkflowFromDev(
              env.SSH_CRED_ID,
              env.WORKFLOW_ID,
              env.SELECTED_SUBWORKFLOW_IDS,
              params.DEV_DEPLOY_TARGET
            )
          }
        }
      }
    }

    stage('Commit & push workflow file only') {
      when {
        expression { params.PIPELINE_MODE in ['DEV_TO_REPO', 'DEV_TO_PROD'] }
      }
      steps {
        script {
          GitWorkflowOps.commitAndPushWorkflowOnly(
            env.GIT_CRED_ID,
            env.WORKFLOW_ID,
            env.SELECTED_SUBWORKFLOW_IDS ?: '',
            env.authorName,
            env.authorEmail
          )
        }
      }
    }

    stage('Validate non-production credentials') {
      when {
        expression {
          params.PIPELINE_MODE in ['REPO_TO_PROD', 'DEV_TO_PROD']
        }
      }
      steps {
        script {
          if (!env.SELECTED_SUBWORKFLOW_IDS?.trim()) {
            env.SELECTED_SUBWORKFLOW_IDS = DeploymentOps.discoverSubWorkflowIdsFromRemoteWorkflowBranch(
              env.GIT_CRED_ID,
              env.WORKFLOW_ID
            ) ?: ''

            echo "Auto-discovered sub-workflow IDs for validation/deploy: ${env.SELECTED_SUBWORKFLOW_IDS ?: '(none)'}"
          }

          DeploymentOps.validateWorkflowCredentialsOnly(
            env.GIT_CRED_ID,
            env.WORKFLOW_ID,
            env.SELECTED_SUBWORKFLOW_IDS ?: ''
          )
        }
      }
    }

    stage('Approval') {
      when {
        expression {
          params.PIPELINE_MODE in ['REPO_TO_PROD', 'DEV_TO_PROD']
        }
      }
      steps {
        script {
          def approvalInfo = PipelineGuard.requestTwoApprovals(
            params.PIPELINE_MODE,
            env.WORKFLOW_ID,
            env.APPROVER,
            env.APPROVER_EMAIL
          )

          env.FIRST_APPROVER  = approvalInfo.firstApprover ?: ''
          env.SECOND_APPROVER = approvalInfo.secondApprover ?: ''

          echo "Approval completed. Level 1: ${env.FIRST_APPROVER}, Level 2: ${env.SECOND_APPROVER}"
        }
      }
    }

    stage('Promote workflow file to master only') {
      when {
        expression { params.PIPELINE_MODE in ['REPO_TO_PROD', 'DEV_TO_PROD'] }
      }
      steps {
        script {
          GitWorkflowOps.promoteWorkflowToMaster(
            env.GIT_CRED_ID,
            env.WORKFLOW_ID,
            env.SELECTED_SUBWORKFLOW_IDS ?: '',
            env.authorName,
            env.authorEmail
          )
        }
      }
    }

    stage('Repo -> Prod (promote creds + deploy)') {
      when {
        expression { params.PIPELINE_MODE in ['REPO_TO_PROD', 'DEV_TO_PROD'] }
      }
      steps {
        script {
          DeploymentOps.deployFromRepoToProd(
            env.SSH_CRED_ID,
            env.WORKFLOW_ID,
            env.SELECTED_SUBWORKFLOW_IDS ?: '',
            params.PROD_DEPLOY_TARGET
          )
        }
      }
    }
  }

  post {
    success {
      script {
        sendEmailTemplate(
          MAILMODE: 'POST_BUILD_REPORT',
          EXTRA_DATA: [
            buildResult: 'SUCCESS',
            firstApprover: env.FIRST_APPROVER,
            secondApprover: env.SECOND_APPROVER
          ]
        )
      }
    }

    failure {
      script {
        sendEmailTemplate(
          MAILMODE: 'POST_BUILD_REPORT',
          EXTRA_DATA: [
            buildResult: 'FAILURE',
            firstApprover: env.FIRST_APPROVER,
            secondApprover: env.SECOND_APPROVER
          ]
        )
      }
    }

    aborted {
      script {
        sendEmailTemplate(
          MAILMODE: 'POST_BUILD_REPORT',
          EXTRA_DATA: [
            buildResult: 'ABORTED',
            firstApprover: env.FIRST_APPROVER,
            secondApprover: env.SECOND_APPROVER
          ]
        )
      }
    }

    always {
      script {
        cleanWs()
      }
    }
  }
}